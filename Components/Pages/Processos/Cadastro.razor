@page "/processos/cadastro"
@page "/processos/editar/{Id:int}"
@rendermode InteractiveServer
@inject ProcessoDAO dao
@inject NavigationManager NavigationManager
<PageTitle>Cadastro de Processo - Sistema de Controle de Processos</PageTitle>
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Cadastro de Processo</h2>
    </div>
</div>
<div class="custom-table-card p-4">
@if (Id.HasValue && !processoEncontrado)
{
    <div class="alert alert-warning" role="alert">
    Processo não encontrado.
    <a href="/processos" class="alert-link">Voltar para a lista</a>
    </div>
}
else
{
    <EditForm Model="processo" OnValidSubmit="Salvar">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" />
        <div class="row mb-3">
            <div class="col-md-4">
                <label for="numero" class="form-label">
                    Numero
                </label>
                <InputText
                    id="numero"
                    class="form-control"
                    @bind-Value="processo.Numero" />
                <ValidationMessage For="() => processo.Numero" />
            </div>
            <div class="col-md-4">
                <label for="situacao" class="form-label">
                    Situacao
                </label>
                <InputSelect
                    id="situacao"
                    class="form-select"
                    @bind-Value="processo.Situacao">
                    <option value="Aberto">Aberto</option>
                    <option value="Em analise">Em analise</option>
                    <option value="Pendente">Pendente</option>
                    <option value="Concluido">Concluido</option>
                    <option value="Arquivado">Arquivado</option>
                </InputSelect>
                <ValidationMessage For="() => processo.Situacao" />
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-12">
                <label for="interessado" class="form-label">
                    Interessado
                </label>
                <InputText
                    id="interessado"
                    class="form-control"
                    @bind-Value="processo.Interessado" />
                <ValidationMessage For="() => processo.Interessado" />
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-12">
                <label for="assunto" class="form-label">
                    Assunto
                </label>
                <InputText
                    id="assunto"
                    class="form-control"
                    @bind-Value="processo.Assunto" />
                <ValidationMessage For="() => processo.Assunto" />
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-12">
                <label for="descricao" class="form-label">
                    Descricaoo
                </label>
                <InputTextArea
                    id="descricao"
                    class="form-control"
                    rows="4"
                    @bind-Value="processo.Descricao" />
                <ValidationMessage For="() => processo.Descricao" />
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i> @(Id.HasValue ? "Atualizar" : "Salvar")
            </button>
            <a href="/processos" class="btn btn-light border">
                Cancelar
            </a>
        </div>
    </EditForm>
}
    
</div>

@code
{
    private Processo processo = new();
    private bool processoEncontrado = true;

    [Parameter]
    public int? Id { get; set; }

    private string Titulo => Id.HasValue ? "Editar Processo" : "Novo Processo";

    protected override void OnParametersSet(){
    if (!Id.HasValue){
    processo = new Processo();
    processoEncontrado = true;
    return;
    }

    var processoCarregado = dao.BuscadorId(Id.Value);
    processoEncontrado = processoCarregado is not null;
        if (processoCarregado is not null){
        processo = processoCarregado;
        }
    }

    private void Salvar()
    {
        if (Id.HasValue){
            dao.Edit(processo);
        } else {
        dao.Inserir(processo);
        }
        // Retorna a p?gina de processos ap?s salvar
        NavigationManager.NavigateTo("/processos");
    }
}
